      "description": {
        "content": "Real-time single-record account/contact enrichment and contact append.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "1f842b0b-ff20-4b1d-a151-25c19f8e7e94",
          "name": "Submit a rapid enrichment request",
          "request": {
            "name": "Submit a rapid enrichment request",
            "description": {
              "content": "Submit a real-time enrichment request. `type` selects the mode — `contact` enriches a single contact, `account` enriches a single company, and `get_contacts` returns matched contacts for a company using the supplied contacts definition.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "enrichment",
                "rapid",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"<string>\",\n  \"data\": {\n    \"org_record_id\": \"<string>\",\n    \"org_company_name\": \"<string>\",\n    \"org_website\": \"<string>\",\n    \"org_linkedin_url\": \"<string>\",\n    \"org_phone\": \"<string>\",\n    \"org_street\": \"<string>\",\n    \"org_city\": \"<string>\",\n    \"org_state\": \"<string>\",\n    \"org_zip_code\": \"<string>\",\n    \"org_country\": \"<string>\",\n    \"org_industry\": \"<string>\",\n    \"org_num_employees\": \"<string>\",\n    \"org_num_employees_exact\": \"<integer>\",\n    \"org_annual_revenue\": \"<string>\",\n    \"contact_record_id\": \"<string>\",\n    \"contact_first_name\": \"<string>\",\n    \"contact_last_name\": \"<string>\",\n    \"contact_email\": \"<string>\",\n    \"contact_job_title\": \"<string>\",\n    \"contact_linkedin_url\": \"<string>\",\n    \"contact_department\": \"<string>\",\n    \"contact_seniority\": \"<string>\"\n  },\n  \"contacts\": {\n    \"contacts_per_company\": \"<integer>\",\n    \"seniority\": \"<string>\",\n    \"department\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
