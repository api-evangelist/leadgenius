            "description": {
              "content": "Submit the account and contact records you would like LeadGenius to exclude. Account records require a company identifier (org_linkedin_url or org_website); contact records require a contact identifier (contact_linkedin_url or contact_email).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "exclusion",
                "upload",
                ""
              ],
              "host": [
                "{{baseUrl}}"
